{
  "gaapo": {
    "population_size": 8,
    "generations": 3,
    "parents_per_generation": 3,
    "random_seed": 42
  },
  "generation_methods": {
    "opro": {
      "enabled": true,
      "candidates_per_generation": 2,
      "dropout": 0.2
    },
    "apo": {
      "enabled": true,
      "candidates_per_generation": 2,
      "batch_size": 4,
      "error_threshold": 0.8
    },
    "mutation": {
      "enabled": true,
      "candidates_per_generation": 2
    },
    "crossover": {
      "enabled": true,
      "candidates_per_generation": 2
    },
    "fewshot": {
      "enabled": true,
      "candidates_per_generation": 2,
      "min_examples": 1,
      "max_examples": 3
    }
  },
  "evaluation": {
    "method": "complete"
  },
  "datasets": {
    "train": "GAAPO/data/train.json",
    "validation": "GAAPO/data/validation.json",
    "test": "GAAPO/data/test.json"
  },
  "target_model": {
    "base_model": "meta-llama/Llama-3.2-1B-Instruct",
    "adapter": "BRINK/model/guidelineKG/finetuned_LLaMA_3.2_1B_with_rules_CoT2",
    "dtype": "float16",
    "device": "cuda:0",
    "max_new_tokens": 256
  },
  "optimizer_llm": {
    "model": "openai/gpt-oss-120b",
    "model_env": "HF_MODEL",
    "base_url": "https://router.huggingface.co/v1",
    "api_key_env": "HF_TOKEN"
  },
  "storyboard_evaluation": {
    "metrics": [
      "format_validity",
      "structure_completeness"
    ],
    "weights": {
      "format_validity": 0.5,
      "structure_completeness": 0.5
    },
    "rubrics": {}
  },
  "initial_variants": [
    "You are a medical video storyboard generator. Write one scene based on the request.",
    "You are a medical video storyboard generator. Think briefly about the key point to convey, then output only the final JSON storyboard as your answer."
  ]
}

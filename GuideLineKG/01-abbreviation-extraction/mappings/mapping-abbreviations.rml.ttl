@prefix rr:   <http://www.w3.org/ns/r2rml#> .
@prefix rml:  <http://semweb.mmlab.be/ns/rml#> .
@prefix ql:   <http://semweb.mmlab.be/ns/ql#> .
@prefix ds:   <http://digistrucmed.org/> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .


#################################################################

<#AbbreviationMap> a rr:TriplesMap ;
    rml:logicalSource [
        rml:source "output/abbreviations.json" ;
        rml:referenceFormulation ql:JSONPath ;
        rml:iterator "$[*]"
    ] ;
    rr:subjectMap [
        rr:template "http://digistrucmed.org/entity/{abbreviation}" ;
        rr:class ds:Abbreviation
    ] ;

    rr:predicateObjectMap [ rr:predicate rdfs:label ; rr:objectMap [ rml:reference "abbreviation" ] ] ;
    rr:predicateObjectMap [ rr:predicate ds:name ; rr:objectMap [ rml:reference "abbreviation" ] ] ;
    rr:predicateObjectMap [ rr:predicate ds:abbreviationMethod ; rr:objectMap [ rml:reference "method" ] ] ;
    rr:predicateObjectMap [ rr:predicate ds:sourceDocument ; rr:objectMap [ rml:reference "source_documents[*]" ] ] ;
    rr:predicateObjectMap [
        rr:predicate ds:hasExpansion ;
        rr:objectMap [ rr:template "http://digistrucmed.org/entity/{expansion}" ; rr:termType rr:IRI ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate ds:hasPluralForm ;
        rr:objectMap [ rr:template "http://digistrucmed.org/entity/{plural_forms_seen}" ; rr:termType rr:IRI ]
    ] .

# The expansion (long form) as its own shared lexical resource - same
# class/predicate pattern as SurfaceFormMap in mapping-json.rml.ttl.
<#ExpansionMap> a rr:TriplesMap ;
    rml:logicalSource [
        rml:source "output/abbreviations.json" ;
        rml:referenceFormulation ql:JSONPath ;
        rml:iterator "$[*]"
    ] ;
    rr:subjectMap [
        rr:template "http://digistrucmed.org/entity/{expansion}" ;
        rr:class ds:Expansion
    ] ;
    rr:predicateObjectMap [ rr:predicate rdfs:label ; rr:objectMap [ rml:reference "expansion" ] ] ;
    rr:predicateObjectMap [ rr:predicate ds:name ; rr:objectMap [ rml:reference "expansion" ] ] .


<#PluralFormMap> a rr:TriplesMap ;
    rml:logicalSource [
        rml:source "output/abbreviations.json" ;
        rml:referenceFormulation ql:JSONPath ;
        rml:iterator "$[*]"
    ] ;
    rr:subjectMap [
        rr:template "http://digistrucmed.org/entity/{plural_forms_seen[*]}" ;
        rr:class ds:Abbreviation
    ] ;
    rr:predicateObjectMap [
        rr:predicate ds:pluralFormOf ;
        rr:objectMap [ rr:template "http://digistrucmed.org/entity/{abbreviation}" ; rr:termType rr:IRI ]
    ] .
